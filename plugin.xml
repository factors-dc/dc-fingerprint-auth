<?xml version="1.0" encoding="UTF-8"?>
<!--
  Danish Crown fork of cordova-plugin-android-fingerprint-auth 1.5.0.
  Same plugin id, JS API and window.FingerprintAuth, but the native side uses
  androidx.biometric BiometricPrompt instead of FingerprintManager + own dialog,
  so under-display fingerprint sensors and Class 3 face unlock work.
-->
<plugin xmlns="http://apache.org/cordova/ns/plugins/1.0"
        xmlns:android="http://schemas.android.com/apk/res/android"
        id="cordova-plugin-android-fingerprint-auth"
        version="1.6.0-dc.1">
    <name>FingerprintAuth</name>
    <description>Android biometric authentication (BiometricPrompt) with the cordova-plugin-android-fingerprint-auth 1.5.0 JS API</description>
    <license>Apache 2.0</license>
    <keywords>cordova,plugin,android,fingerprint,biometric,authentication</keywords>

    <engines>
        <engine name="cordova-android" version=">=10.0.0" />
    </engines>

    <js-module src="www/FingerprintAuth.js" name="FingerprintAuth">
        <clobbers target="FingerprintAuth" />
    </js-module>

    <platform name="android">
        <preference name="ANDROIDX_BIOMETRIC_VERSION" default="1.1.0" />

        <config-file target="res/xml/config.xml" parent="/*">
            <feature name="FingerprintAuth">
                <param name="android-package" value="com.cordova.plugin.android.fingerprintauth.FingerprintAuth"/>
            </feature>
        </config-file>
        <config-file target="AndroidManifest.xml" parent="/*">
            <uses-permission android:name="android.permission.USE_FINGERPRINT" />
            <uses-permission android:name="android.permission.USE_BIOMETRIC" />
        </config-file>

        <framework src="androidx.biometric:biometric:$ANDROIDX_BIOMETRIC_VERSION" />

        <source-file src="src/android/FingerprintAuth.java" target-dir="src/com/cordova/plugin/android/fingerprintauth" />

        <resource-file src="res/android/values/fpauth-strings.xml" target="res/values/fpauth-strings.xml" />
        <resource-file src="res/android/values-da/fpauth-strings.xml" target="res/values-da/fpauth-strings.xml" />
        <resource-file src="res/android/values-de/fpauth-strings.xml" target="res/values-de/fpauth-strings.xml" />
        <resource-file src="res/android/values-sv/fpauth-strings.xml" target="res/values-sv/fpauth-strings.xml" />
    </platform>
</plugin>
